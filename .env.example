# ─────────────────────────────────────────────
# AutoTrans Bot - 環境変数設定ファイル
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# 必須設定
# ─────────────────────────────────────────────

# Discord Botトークン（Developer Portalから取得）
DISCORD_TOKEN=your_discord_bot_token_here

# 翻訳結果を送信するテキストチャンネルのID
# Discordの開発者モードを有効にしてチャンネルを右クリック→「チャンネルIDをコピー」
TEXT_CHANNEL_ID=123456789012345678

# スラッシュコマンドを即時反映させるサーバー（ギルド）のID
# Discordの開発者モードを有効にしてサーバー名を右クリック→「IDをコピー」
# 設定するとギルドコマンドとして即時反映されます（未設定の場合はグローバルコマンドで最大1時間かかります）
GUILD_ID=123456789012345678

# ─────────────────────────────────────────────
# オプション設定（デフォルト値で動作します）
# ─────────────────────────────────────────────

# OllamaサーバーのURL（デフォルト: http://localhost:11434）
# OLLAMA_BASE_URL=http://localhost:11434

# 使用するOllamaモデル（デフォルト: qwen2.5:7b-instruct）
# OLLAMA_MODEL=qwen2.5:7b-instruct

# 使用するWhisperモデル（デフォルト: large-v3-turbo）
# 小さいモデル: medium, small, base（VRAMが少ない場合）
# WHISPER_MODEL=large-v3-turbo

# VAD無音検知閾値（ミリ秒）（デフォルト: 400）
# 300〜500の範囲で調整してください
# VAD_SILENCE_THRESHOLD_MS=400

# VAD発話判定閾値（0.0〜1.0）（デフォルト: 0.5）
# 値を下げると感度が上がります（誤検知が増える可能性あり）
# VAD_THRESHOLD=0.5
